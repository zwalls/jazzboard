# Required in deployed environments. Connect a PRIVATE Vercel Blob store with
# the `JAZZBOARD_PRIVATE_` prefix to supply this value automatically; never
# commit a real token.
JAZZBOARD_PRIVATE_READ_WRITE_TOKEN=

# Required safety assertion for the connected store. Jazzboard fails closed if
# a Blob token exists without this private-store marker.
JAZZBOARD_BLOB_ACCESS=private

# Required for deployed room authority and legacy Redis asset reads.
REDIS_URL=

# Emergency-only opt-in. Normal Vercel deployments fail image uploads closed
# when Blob is unavailable instead of writing new image bytes to Redis.
JAZZBOARD_ALLOW_REDIS_ASSET_FALLBACK=0

# Use `warn` for a measurement-only rollout or `enforce` to reject an
# oversized room atomically before Redis persistence.
JAZZBOARD_CAPACITY_MODE=enforce

# Required by Vercel Cron for the bounded daily private Blob orphan cleanup.
# Use a distinct high-entropy value; Vercel sends it as a Bearer credential.
CRON_SECRET=

# Required in production; use at least 32 random characters.
SESSION_SECRET=

# Optional Chrome WebMCP origin-trial token for the exact deployed origin.
# Obtain it through Chrome Origin Trials; never invent or reuse another origin's token.
WEBMCP_ORIGIN_TRIAL_TOKEN=
